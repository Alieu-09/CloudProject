<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    admin dashboard
  </title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />

  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,700;1,700&display=swap"
    rel="stylesheet" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


</head>
<body>
  <header>
  <%- include("../partials/nav") %>
  </header>

<h1>Edit Game</h1>

<form action="/admin/edit/<%= game.id %>" method="POST">

  <label>Title</label>
  <input type="text" name="title" value="<%= game.title %>" />

  <label>Price</label>
  <input type="number" name="price" value="<%= game.price %>" />

  <label>Genre</label>
  <input type="text" name="genre" value="<%= game.genre %>" />

  <button type="submit">Save</button>

</form>

</body>
</html>