<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    home
  </title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />

  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,700;1,700&display=swap"
    rel="stylesheet" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


</head>
<body>
  <header>
  <%- include("../partials/nav") %>
  </header>

<h1>Games Overview</h1>


<table class="table table-sort">
  <thead>
    <tr>
      <th>image</th>
      <th>
        <div class="d-flex align-items-center gap-2">
          <span>ID</span>

          <a href="/games?sort=id&order=asc">
            <i class="fa-solid fa-arrow-up"></i>
          </a>

          <a href="/games?sort=id&order=desc">
            <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
      </th>
      <th>
        <div class="d-flex align-items-center gap-2">
          <span>Titel</span>

          <a href="/games?sort=title&order=asc">
            <i class="fa-solid fa-arrow-up"></i>
          </a>

          <a href="/games?sort=title&order=desc">
            <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
      </th>
      <th>Genre</th>
      <th>
        <div class="d-flex align-items-center gap-2">
          <span>Prijs</span>

          <a href="/games?sort=price&order=asc">
            <i class="fa-solid fa-arrow-up"></i>
          </a>

          <a href="/games?sort=price&order=desc">
            <i class="fa-solid fa-arrow-down"></i>
          </a>
        </div>
      </th>
      <th>Details</th>
    </tr>
  </thead>

    <tbody>
      <% games.forEach(game => { %>
      <tr>
        <td><img src="<%= game.imageUrl %>" width="80" /></td>
        <td><%= game.id %></td>
        <td><%= game.title %></td>
        <td><%= game.genre %></td>
        <td>€<%= game.price %></td>
        <td>
          <a href="/games/<%= game.id %>">Details</a>
        </td>
      </tr>
      <% }) %>
    </tbody>
</table>

</body>
</html>